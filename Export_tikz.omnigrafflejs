// COPY & PASTE into editor app. EDIT & SAVE with “.omnigrafflejs” file extension.
/*{
	"type": "action",
	"targets": ["omnigraffle"],
	"author": "John Komp",
	"identifier": "com.sbindustries.gentikz",
	"version": "0.4",
	"description": "Convert and export current selection as a tikz graphic",
	"label": "Export_tikz",
	"shortLabel": "Export_tikz",
	"paletteLabel": "Export_tikz",
	"image": "gearshape"
}*/
(() => {

  clrTable = new Map();
  clrTag = 0;

  // Data Structures
  class graphBounds {
    constructor(lPoint, rPoint) {
      this.leftPoint  = lPoint;
      this.rightPoint = rPoint;
    }
  }

  class colorInfo {
    constructor(clrName, tikzStr) {
      this.clrName = clrName;
      this.tikzStr = tikzStr;
    }
  }

  //
  function getArrows(head, tail) {
    arrows = ''
    if (tail == 'FilledArrow') {
      arrows += 'latex'
    }
    arrows += '-'
    if (head == 'FilledArrow') {
      arrows += 'latex'
    }
    return arrows
  }

  function componentToHex(c){
		var hex = c.toString(16);
		return hex.length == 1 ? "0" + hex : hex;
	}

  function HEXforColor(clrObj) {

		r = Math.round(clrObj.red   * 255)
		g = Math.round(clrObj.green * 255)
		b = Math.round(clrObj.blue  * 255)

		return "#" + componentToHex(r) + componentToHex(g) + componentToHex(b);
	}

	// Find the given color in the color table. Add it if missing.
  function getColor(color) {

    key = ''
    if ((color.colorSpace == ColorSpace.RGB)||(color.colorSpace == ColorSpace.White)) {
      key = HEXforColor(color);
      if (clrTable.has(key) == false) {
        clrTable.set(key, new colorInfo(`c${clrTag}`, `\\definecolor{c${clrTag}} {RGB} {${Math.round(color.red * 255)},${Math.round(color.green * 255)},${Math.round(color.blue  * 255)}}`))
        clrTag += 1
      }
    }
    return clrTable.get(key)
  }

  function doLine(graphic) {
    tikzLine = ''
    draw = ''
    type = graphic.lineType
    tmp = LineType.Straight

    if (graphic.lineType == LineType.Curved || graphic.lineType == LineType.Straight) {

      // console.log(`Head: ${graphic.head.text} ${graphic.head.id} Tail: ${graphic.tail.text} ${graphic.tail.id}`)
      // Origin of this drawing code: https://tex.stackexchange.com/questions/624010/using-tikz-spath3-with-nodes
      //
      // \path[spath/save=curveA] plot[smooth,tension=1] coordinates {
        //   (S0)
        //   (-17.600000262260437pt,3.89259546372341pt)
        //   (15.955999737740058pt,28.233391483626292pt)
        //   (S0)
        // };
      path = `\\path[spath/save=curveA] plot[smooth,tension=1] coordinates {`;
      for (let i = 0; i < graphic.points.length; i++) {
        originX = graphic.points[i].x - bounds.leftPoint.x
        originY = -(graphic.points[i].y - bounds.leftPoint.y)
        path += `   (${originX.toFixed(5)}pt, ${originY.toFixed(5)}pt)`
      }
      path += '}';
      // console.log(`${graphic.id}${graphic.connectedLines};`)
      tikzLine += `${path};\n`
      // console.log(`${graphic.head} ${graphic.tail}`)
      // console.log(`${graphic.head == null} ${graphic.tail == null}`)
      // console.log(`${graphic.head != null} ${graphic.tail != null}`)
      if ((graphic.head instanceof Shape || graphic.tail instanceof Shape)) {
      // if ((graphic.head == null && graphic.tail == null) == false) {
        head = ''
        tail = ''

        // \tikzset{spath/.cd,split at intersections with={curveA}{4568border},split at intersections with={curveA}{4563border},remove components={curveA}{1,3}};
        if ((graphic.head == null || graphic.head instanceof Line) && graphic.tail != null && graphic.tail instanceof Shape) {
          tail = `split at intersections with={curveA}{${graphic.tail.id}border}`
          head = ''
          remove = '2'
          reverse = 'reverse={curveA}'
        }
        else  if (graphic.head != null && graphic.head instanceof Shape && (graphic.tail == null || graphic.tail instanceof Line)) {
          head = `split at intersections with={curveA}{${graphic.head.id}border}`
          if (graphic.tailType != null) {
            reverse = `reverse={curveA}`
            remove = '1'
          }
          else {
            reverse = ``
            remove = '2'
          }

        }
        else {
          head = `split at intersections with={curveA}{${graphic.head.id}border}`
          tail = `split at intersections with={curveA}{${graphic.tail.id}border}`
          remove = '1,3'
          reverse = ''
       }
        set = `\\tikzset{spath/.cd, ${reverse}, ${head},${tail},remove components={curveA}{${remove}}, ${reverse}}`;
        tikzLine += `${set};\n`
      }
      // \draw[-Latex,red!70!black,line width=2pt,spath/use=curveA];
      arrows = getArrows(graphic.headType, graphic.tailType)
      clr = `${getColor(graphic.strokeColor).clrName}, opacity=${graphic.strokeColor.alpha}`
      draw = `\\draw[${arrows},${clr},line width=${graphic.strokeThickness}pt,spath/use=curveA];`;
      tikzLine += `${draw};\n`
    }
    else {
      draw = `${type}`
      tikzLine += `% Unhandled line type: ${draw};\n`
    }

    return tikzLine
  }

  function getHorizontalAlignment(g) {
    if (g.textHorizontalAlignment == HorizontalTextAlignment.Left) {
      return 'left';
    }
    if (g.textHorizontalAlignment == HorizontalTextAlignment.Center) {
      return 'center';
    }
    if (g.textHorizontalAlignment == HorizontalTextAlignment.Right) {
      return 'right';
    }
  }

  function doShape(graphic, bounds) {
    tikzLine = ''
    rect = graphic.geometry;

    // Rebaseline the shape's origin
    originX = rect.origin.x - bounds.leftPoint.x
    originY = -(rect.origin.y - bounds.leftPoint.y)

    nodeName = graphic.id
    nodeLoc = `(${(originX + rect.width / 2).toFixed(5)}pt, ${(originY - rect.height / 2).toFixed(5)}pt)`;
    re = /\n/gi
    nodeText = (graphic.text).replace(re, '\\\\');
    re = /[^\x00-\x7F]+/gi
    nodeText = (nodeText).replace(re, '-');
    re = /\}/gi
    nodeText = (nodeText).replace(re, '\\}');
    re = /\{/gi
    nodeText = (nodeText).replace(re, '\\{');

    alignment = getHorizontalAlignment(graphic);
    minSize = rect.width.toFixed(5)

    textWidth = ''
    if (graphic.textWraps) {
      textWidth = `text width = ${minSize - (2 * graphic.textHorizontalPadding)}`
    }

    tikzLine += `% ${nodeText} c: ${HEXforColor(graphic.textColor)} flow: ${graphic.textFlow} g: ${graphic.textGeometry} hl: ${graphic.textHorizontalAlignment} r: ${graphic.textRotation} size:  ${graphic.textSize} ${graphic.textUnitRect} ${graphic.textWraps} ${graphic.textHorizontalPadding}\n`

    drawClr = ''
    if (graphic.strokeColor != null) {
      drawClr = `draw=${getColor(graphic.strokeColor).clrName}, opacity=${graphic.strokeColor.alpha}`
    }

    fillClr = ''
    if (graphic.fillColor != null) {
      fillClr = `fill=${getColor(graphic.fillColor).clrName}, opacity=${graphic.fillColor.alpha}`
    }

    if (graphic.shape == "Circle") {
      //\node[draw, circle, minimum size=72pt, inner sep=0pt, spath/save global=S0border] (S0) at (36pt,-36pt) {S0};
      nodeParams = `[${drawClr}, ${fillClr}, font=\\fontsize{${ graphic.textSize }} { 0 } \\selectfont, align=${alignment}, circle,line width=${graphic.strokeThickness}pt, minimum size=${minSize}pt, ${textWidth}, inner sep=0pt, spath/save global=${nodeName}border]`;
    }
    else if (graphic.shape == "Rectangle") {

      nodeParams = `[${drawClr}, ${fillClr}, font=\\fontsize{${ graphic.textSize }} { 0 } \\selectfont, align=${alignment}, rectangle,line width=${graphic.strokeThickness}pt, minimum width=${minSize}pt, minimum height=${(rect.height).toFixed(5)}pt, ${textWidth}, inner sep=0pt, spath/save global=${nodeName}border]`;
    }
    else {
      console.log(`Unknown Shape: ${graphic.shape}`);
      tikzLine = `%\n Unknown Shape: ${graphic.shape}\n`;
      return tikzLine
    }

    // Note: tikz textcolor {color}{text to color} will fail if 'text to color' contains a CR (\\)
    if (nodeText.length > 0) {
      nodeText = `\\textcolor\{${getColor(graphic.textColor).clrName}\}${nodeText}`
    }
    draw = `\\node ${nodeParams} (${nodeName}) at ${nodeLoc} \{${nodeText}\};`
    tikzLine += `${draw}\n`;

    // console.log(`${bounds.leftPoint.x} ${rect.origin.x} ${originX}`)
    // console.log(`${bounds.leftPoint.y} ${rect.origin.y} ${originY}`)
    return tikzLine
  }

  function fileHeader() {

    console.log('\\adjustbox{max width=12cm}{');
    console.log(`\\begin{tikzpicture}`);
  }

  function fileTrailer() {

    console.log(`\\end{tikzpicture}`)
    console.log(`}`)
  }

  function findOffset(graphics) {

    const xCoords = []
    const yCoords = []
    for (let i = 0; i < graphics.length; i++) {
      rect = graphics[i].geometry;
      console.log(`${rect.origin.x} ${rect.origin.y}`)
	    xCoords.push(rect.origin.x);
			yCoords.push(rect.origin.y);
    }

    minPoint = new Point(Math.min(...xCoords),Math.min(...yCoords)) //Upper left
    maxPoint = new Point(Math.max(...xCoords),Math.max(...yCoords)) //Lower right
    console.log(`Min: ${minPoint.x} ${minPoint.y}`)
    console.log(`Max: ${maxPoint.x} ${maxPoint.y}`)

    return (new graphBounds(minPoint, maxPoint));
  }

	var action = new PlugIn.Action(function(selection, sender){
		// action code
		// selection options: canvas, document, graphics, lines, solids, view

		// console.log(`${selection.canvas.pageSize} ${selection.canvas.size}`)
		console.log(`Total Items Selected: ${selection.graphics.length}`)
    bounds = findOffset(selection.graphics)

    // console.log(`Bounds: ${bounds.leftPoint} - ${bounds.rightPoint}`);

    fileHeader()

    tikzShapes = ''
    tikzShapes += '\n% Draw all shapes\n'
		for (let i = 0; i < selection.solids.length; i++) {
      tikzShapes += doShape(selection.solids[i], bounds) + '\n'
    }

    tikzLines = ''
		tikzLines += '\n% Draw all lines\n'
		for (let i = 0; i < selection.lines.length; i++) {
		  tikzLines += doLine(selection.lines[i]) + '\n'
    }

    for (let i = 0; i < selection.graphics.length; i++) {
      if (selection.graphics[i] instanceof Group) {
        for (let j = 0; j < selection.graphics[i].graphics.length; j++) {
          if (selection.graphics[i].graphics[j] instanceof Shape){
            tikzShapes += doShape(selection.graphics[i].graphics[j], bounds) + '\n'
          }
          if (selection.graphics[i].graphics[j] instanceof Line){
            tikzLines += doLine(selection.graphics[i].graphics[j]) + '\n'
          }
        }
      }
    }

		//Dump all the tikz lines to the console
    for (const value of clrTable.values()) {
      console.log(`${value.tikzStr}`);
    }

    console.log(`${tikzShapes}`)
		console.log(`${tikzLines}`)

    fileTrailer()

	});

	action.validate = function(selection, sender){
		// validation code
		// selection options: canvas, document, graphics, lines, solids, view
		return true
	};

	return action;
})();
